@using SeedsProject.Models
@model Seed

@{
    ViewData["Title"] = "Seed Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Name</dt>
                        <dd class="col-sm-9">@Model.Name</dd>

                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">@Model.Description</dd>

                        <dt class="col-sm-3">Price</dt>
                        <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

                        <dt class="col-sm-3">Approval Status</dt>
                        <dd class="col-sm-9">
                            @if (Model.Approval)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Pending Approval</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Stock</dt>
                        <dd class="col-sm-9">
                            <span class="badge @(Model.Stock > 20 ? "bg-success" : Model.Stock > 5 ? "bg-warning" : "bg-danger")">
                                @Model.Stock
                            </span>
                        </dd>

                        <dt class="col-sm-3">Expiry Date</dt>
                        <dd class="col-sm-9">
                            <span class="badge @(Model.ExpiryDate > DateTime.Now.AddDays(30) ? "bg-success" : Model.ExpiryDate > DateTime.Now ? "bg-warning" : "bg-danger")">
                                @Model.ExpiryDate.ToString("MMM dd, yyyy")
                            </span>
                        </dd>

                        <dt class="col-sm-3">Category</dt>
                        <dd class="col-sm-9">
                            @if (Model.Category != null)
                            {
                                <span class="badge bg-info">@Model.Category.Name</span>
                                @if (!string.IsNullOrEmpty(Model.Category.Description))
                                {
                                    <br />
                            
                                    <small class="text-muted">@Model.Category.Description</small>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Not specified</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Agent</dt>
                        <dd class="col-sm-9">
                            @if (Model.Agent != null)
                            {
                                <strong>@Model.Agent.Name</strong>
                                @if (!string.IsNullOrEmpty(Model.Agent.Email))
                                {
                                    <br />
                            
                                    <small class="text-muted">📧 @Model.Agent.Email</small>
                                }
                                @if (!string.IsNullOrEmpty(Model.Agent.Phone))
                                {
                                    <br />
                            
                                    <small class="text-muted">📞 @Model.Agent.Phone</small>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Not specified</span>
                            }
                        </dd>

                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <dt class="col-sm-3">Image</dt>
                            <dd class="col-sm-9">
                                <img src="@Model.Image" alt="Seed image" class="img-thumbnail" style="max-width: 200px;" />
                                <br /><small class="text-muted"><a href="@Model.Image" target="_blank">View original</a></small>
                            </dd>
                        }

                        <dt class="col-sm-3">Created Date</dt>
                        <dd class="col-sm-9">@Model.CreatedDate.ToString("MMM dd, yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Last Modified</dt>
                        <dd class="col-sm-9">@Model.ModifiedDate.ToString("MMM dd, yyyy HH:mm")</dd>
                    </dl>

                    <div class="mt-3 d-flex align-items-center gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>

                        <div class="input-group" style="width:160px;">
                            <input type="number" id="qty-@Model.Id" class="form-control" min="1" max="@Model.Stock" value="1" />
                            <button type="button" class="btn btn-success" onclick="addToCart(@Model.Id)">
                                <i class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="cart-alert" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true" style="position:fixed; right:20px; bottom:20px; display:none;">
    <div class="d-flex">
        <div class="toast-body" id="cart-alert-body"></div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="hideCartAlert()" aria-label="Close"></button>
    </div>
</div>

@section Scripts {
    <script>
        async function addToCart(seedId) {
            const qtyInput = document.getElementById(`qty-${seedId}`);
            let quantity = parseInt(qtyInput?.value || "1", 10);
            if (!quantity || quantity < 1) quantity = 1;

            try {
                const res = await fetch('/api/Order/AddToCart', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ seedId: seedId, quantity: quantity })
                });

                if (!res.ok) {
                    const txt = await res.text();
                    alert('Error adding to cart: ' + txt);
                    return;
                }

                const data = await res.json();
                showCartAlert(`${quantity} item(s) added. Cart count: ${data.cartCount ?? data.CartCount ?? ''}`);
            } catch (err) {
                console.error(err);
                alert('An error occurred while adding to cart.');
            }
        }

        function showCartAlert(message) {
            const toastEl = document.getElementById('cart-alert');
            const body = document.getElementById('cart-alert-body');
            body.textContent = message;
            toastEl.style.display = 'block';
            setTimeout(() => { toastEl.style.display = 'none'; }, 2500);
        }

        function hideCartAlert() {
            document.getElementById('cart-alert').style.display = 'none';
        }
    </script>
}