@model SeedsProject.Models.Order
@using SeedsProject.Models

@{
    ViewData["Title"] = "Create Order";

    var seeds = ViewBag.Seeds as IEnumerable<Seed> ?? Enumerable.Empty<Seed>();
    var optionsBuilder = new System.Text.StringBuilder();
    foreach (var s in seeds)
    {
        optionsBuilder.Append($"<option value=\"{s.Id}\">{s.Name}</option>");
    }
    var seedOptionsHtml = optionsBuilder.ToString();
}

<h2>Create New Order</h2>

<form asp-action="Create" method="post" id="orderForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="UserId" class="control-label"></label>
        <input asp-for="UserId" class="form-control" />
        <span asp-validation-for="UserId" class="text-danger"></span>
    </div>

    <h4>Order Items</h4>
    <table class="table" id="orderItemsTable">
        <thead>
            <tr>
                <th>Product</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.OrderItems != null && Model.OrderItems.Any())
            {
                int quantity;
                decimal priceAtPurchase;
                for (int i = 0; i < Model.OrderItems.Count; i++)
                {
                    quantity = Model.OrderItems.ToList()[i].Quantity;
                    priceAtPurchase = Model.OrderItems.ToList()[i].PriceAtPurchase;

                    <tr class="order-item-row">
                        <td>
                            <select name="OrderItems[@i].SeedId" class="form-control item-select" required>
                                <option value="">-- Select Product --</option>
                                @foreach (var s in seeds)
                                {
                                    var isSelected = s.Id == Model.OrderItems.ToList()[i].SeedId ? "selected" : "";
                                    <option value="@s.Id" selected="@isSelected">
                                        @s.Name
                                    </option>
                                }
                            </select>
                        </td>
                        <td>
                            <input name="OrderItems[@i].Quantity" type="number" class="form-control quantity" value="@quantity" min="1" required />
                        </td>
                        <td>
                            <input name="OrderItems[@i].PriceAtPurchase" class="form-control unit-price" value="@priceAtPurchase" readonly />
                        </td>
                        <td class="item-subtotal">0.00</td>
                        <td><button type="button" class="btn btn-danger btn-sm remove-row">Remove</button></td>
                    </tr>
                }
            }
            else
            {
                <tr class="order-item-row">
                    <td>
                        <select name="OrderItems[0].SeedId" class="form-control item-select" required>
                            <option value="">-- Select Product --</option>
                            @Html.Raw(seedOptionsHtml)
                        </select>
                    </td>
                    <td>
                        <input name="OrderItems[0].Quantity" type="number" class="form-control quantity" value="1" min="1" required />
                    </td>
                    <td>
                        <input name="OrderItems[0].PriceAtPurchase" class="form-control unit-price" readonly />
                    </td>
                    <td class="item-subtotal">0.00</td>
                    <td><button type="button" class="btn btn-danger btn-sm remove-row">Remove</button></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-right"><strong>Total Amount:</strong></td>
                <td colspan="2"><strong id="grandTotal">0.00</strong></td>
            </tr>
        </tfoot>
    </table>

    <button type="button" id="addItemBtn" class="btn btn-secondary">Add Item</button>
    <button type="submit" class="btn btn-primary">Place Order</button>
</form>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        var seedOptionsHtml = `@Html.Raw(seedOptionsHtml)`;

        function recalculateTotals() {
            let grandTotal = 0;
            $("#orderItemsTable tbody tr").each(function () {
                let qty = parseFloat($(this).find(".quantity").val()) || 0;
                let price = parseFloat($(this).find(".unit-price").val()) || 0;
                let subtotal = qty * price;
                $(this).find(".item-subtotal").text(subtotal.toFixed(2));
                grandTotal += subtotal;
            });
            $("#grandTotal").text(grandTotal.toFixed(2));

            if ($("#TotalAmount").length === 0) {
                $("<input>").attr({
                    type: "hidden",
                    id: "TotalAmount",
                    name: "TotalAmount"
                }).appendTo("#orderForm");
            }
            $("#TotalAmount").val(grandTotal.toFixed(2));
        }

        // When a product (seed) is selected we fetch its current price.
        // Adjust endpoint to your API if different (example: /api/seeds/{id})
        $(document).on("change", ".item-select", function () {
            let row = $(this).closest("tr");
            let seedId = $(this).val();
            if (seedId) {
                $.getJSON("/api/seeds/" + seedId, function (data) {
                    // Expecting the API returns an object with a Price property
                    let price = data?.price ?? data?.Price ?? 0;
                    row.find(".unit-price").val(price);
                    recalculateTotals();
                }).fail(function () {
                    row.find(".unit-price").val(0);
                    recalculateTotals();
                });
            } else {
                row.find(".unit-price").val(0);
                recalculateTotals();
            }
        });

        $(document).on("input", ".quantity", function () {
            recalculateTotals();
        });

        $("#addItemBtn").click(function () {
            let index = $("#orderItemsTable tbody tr").length;
            let newRow = `
                <tr class="order-item-row">
                    <td>
                        <select name="OrderItems[${index}].SeedId" class="form-control item-select" required>
                            <option value="">-- Select Product --</option>
                            ${seedOptionsHtml}
                        </select>
                    </td>
                    <td>
                        <input name="OrderItems[${index}].Quantity" type="number" class="form-control quantity" value="1" min="1" required />
                    </td>
                    <td>
                        <input name="OrderItems[${index}].PriceAtPurchase" class="form-control unit-price" readonly />
                    </td>
                    <td class="item-subtotal">0.00</td>
                    <td><button type="button" class="btn btn-danger btn-sm remove-row">Remove</button></td>
                </tr>`;
            $("#orderItemsTable tbody").append(newRow);
            recalculateTotals();
        });

        $(document).on("click", ".remove-row", function () {
            if ($("#orderItemsTable tbody tr").length > 1) {
                $(this).closest("tr").remove();
                // Re-index names so model binding works
                $("#orderItemsTable tbody tr").each(function (newIndex) {
                    $(this).find("select[name^='OrderItems']").attr("name", `OrderItems[${newIndex}].SeedId`);
                    $(this).find("input[name^='OrderItems']").attr("name", function () {
                        let oldName = $(this).attr("name");
                        if (oldName.includes("Quantity")) return `OrderItems[${newIndex}].Quantity`;
                        if (oldName.includes("PriceAtPurchase")) return `OrderItems[${newIndex}].PriceAtPurchase`;
                        return oldName;
                    });
                });
                recalculateTotals();
            } else {
                alert("Order must have at least one item.");
            }
        });

        // initial calculation on load
        $(function () { recalculateTotals(); });
    </script>
}