@using SeedsProject.ViewModels
@model HomeIndexViewModel

@{
    ViewData["Title"] = "SeedsProject Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    @* Hero carousel for featured seeds *@
    @await Html.PartialAsync("~/Views/Shared/_HeroCarousel.cshtml", Model.Featured)

    <div class="row g-4">
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Shop Seeds</h4>
                <div>
                    <a asp-controller="Seeds" asp-action="Index" class="btn btn-outline-secondary btn-sm">View all</a>
                    <a asp-controller="Order" asp-action="CartView" class="btn btn-success btn-sm ms-2">
                        <i class="fas fa-shopping-cart"></i> Cart
                    </a>
                </div>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
                @foreach (var seed in Model.Seeds)
                {
                    <div class="col">
                        @await Html.PartialAsync("~/Views/Shared/_ProductCard.cshtml", seed)
                    </div>
                }
            </div>
        </div>

        <aside class="col-lg-3">
            <div class="card sticky-top" style="top:80px;">
                <div class="card-body">
                    <h5 class="card-title">Categories</h5>
                    <ul class="list-unstyled mb-3">
                        @foreach (var c in Model.Categories)
                        {
                            <li>
                                <a asp-controller="Categories" asp-action="Index" class="text-decoration-none">
                                    <i class="fas fa-seedling text-success me-1"></i> @c.Name
                                </a>
                            </li>
                        }
                    </ul>

                    <h6 class="mt-3">Popular</h6>
                    @if (Model.Popular?.Any() ?? false)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var p in Model.Popular)
                            {
                                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" asp-controller="Seeds" asp-action="Details" asp-route-id="@p.Id">
                                    <span>@p.Name</span>
                                    <small class="text-success">@p.Price.ToString("C")</small>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </aside>
    </div>
</div>

@section Styles {
    <style>
        .card .card-body .card-title { font-size: 1rem; }
        .text-truncate { overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
    </style>
}

@section Scripts {
    <script>
        async function addToCart(seedId) {
            const qtyInput = document.getElementById(`qty-${seedId}`) || document.getElementById(`hero-qty-${seedId}`);
            let quantity = parseInt(qtyInput?.value || "1", 10);
            if (!quantity || quantity < 1) quantity = 1;

            try {
                const res = await fetch('/api/Order/AddToCart', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ seedId: seedId, quantity: quantity })
                });

                if (!res.ok) {
                    const txt = await res.text();
                    alert('Error adding to cart: ' + txt);
                    return;
                }

                // update layout badge if available
                if (window.updateCartCount) window.updateCartCount();

                // simple toast
                const message = `${quantity} item(s) added to cart.`;
                const toast = document.createElement('div');
                toast.className = 'toast align-items-center text-bg-success border-0';
                toast.style.position = 'fixed';
                toast.style.right = '20px';
                toast.style.bottom = '20px';
                toast.innerHTML = `<div class="d-flex"><div class="toast-body">${message}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="this.closest('.toast').remove()"></button></div>`;
                document.body.appendChild(toast);
                setTimeout(() => toast.remove(), 2500);
            } catch (err) {
                console.error(err);
                alert('An error occurred while adding to cart.');
            }
        }
    </script>
}