@model SeedsProject.ViewModels.CartViewModel

@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Checkout</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (!Model.Items.Any())
{
    <div class="alert alert-info">Your cart is empty. <a asp-controller="Seeds" asp-action="Index">Browse seeds</a>.</div>
}
else
{
    <form asp-action="CheckoutConfirm" method="post">
        @Html.AntiForgeryToken()
        <table class="table">
            <thead>
                <tr>
                    <th>Seed</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var it in Model.Items)
                {
                    <tr>
                        <td>@it.Name</td>
                        <td>@it.Price.ToString("C")</td>
                        <td>@it.Quantity</td>
                        <td>@it.SubTotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-end"><strong>Total:</strong></td>
                    <td><strong>@Model.Total.ToString("C")</strong></td>
                </tr>
            </tfoot>
        </table>

        <div class="mb-3">
            <label class="form-label">Shipping Address (optional)</label>
            <textarea class="form-control" name="ShippingAddress" rows="3"></textarea>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="CartView" class="btn btn-secondary">Back to Cart</a>
            <button type="submit" class="btn btn-success">Confirm Purchase</button>
        </div>
    </form>
}